# FIX: chỉ cấu hình mẫu, không chứa bí mật thật. Không deploy nguyên mẫu chưa điền.
# Render: điền Environment; local: sao chép thành .env không được commit.
# Secret đã lộ cần đổi ở nhà cung cấp trước khi sử dụng.
ASPNETCORE_ENVIRONMENT=Production
# Connection string thật: Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require
ConnectionStrings__DefaultConnection=
# Khóa ngẫu nhiên riêng tối thiểu 32 byte, không dùng chuỗi mẫu làm khóa thật.
JwtOptions__SecretKey=
JwtOptions__Issuer=kakastartupprojectkeke
JwtOptions__Audience=kakastartupprojectkeke
JwtOptions__ExpireMinutes=120
CloudinaryOptions__CloudName=
CloudinaryOptions__ApiKey=
CloudinaryOptions__ApiSecret=
